# Copy to backend/.env and fill in. The API reads .env from its working directory (backend/).
PORT=5000
# Local MongoDB:  mongodb://127.0.0.1:27017/7heaven_crm
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/7heaven_crm
MONGODB_URI=mongodb://127.0.0.1:27017/7heaven_crm
# Use a long random string in production, e.g.  openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
