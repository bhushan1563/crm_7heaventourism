# Copy to backend/.env and fill in. The API finds backend/.env wherever it is started from (override with ENV_FILE=/path/to/.env).
# On Vercel / Hostinger Node.js hosting you can set these in the control panel instead (variables already set there win over this file).
# On a VPS, deploy/setup-vps.sh writes this file for you (chmod 600) with a freshly generated JWT_SECRET.

PORT=5000
NODE_ENV=development
# Network interface to listen on. Default 0.0.0.0 (all). Behind Nginx on a VPS use 127.0.0.1 so only Nginx can reach the app.
# HOST=127.0.0.1

# Local MongoDB:  mongodb://127.0.0.1:27017/7heaven_crm
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/7heaven_crm
MONGODB_URI=mongodb://127.0.0.1:27017/7heaven_crm

# REQUIRED in production - the API refuses to start without it (and rejects this placeholder).
# Generate one:  openssl rand -hex 48        Changing it signs every user out once.
JWT_SECRET=change-me-to-a-long-random-string
# How long a login lasts (default 7d).
# JWT_EXPIRES_IN=7d

# --- Optional -----------------------------------------------------------------------------------

# Browser origins allowed to call the API from another domain, comma-separated. Leave unset when the web app and
# the API share one origin (the default setup) or to allow any origin.
# CORS_ORIGINS=https://crm.example.com,https://www.example.com

# Reverse proxies in front of the app (Nginx / Vercel = 1). Defaults to 1 in production, 0 in development.
# TRUST_PROXY=1

# Atlas "querySrv ECONNREFUSED" on a restrictive network? Resolve through public DNS. (Development already does.)
# DNS_SERVERS=8.8.8.8,8.8.4.4

# Where `npm run backup-db` writes backups (default: <repo>/backups). Keep it outside the web root and private.
# BACKUP_DIR=/var/backups/7heaven

# First run only: create this Admin when the database has no users, then REMOVE both lines.
# (Or run `npm run create-admin -- <email> <password>` from the repo root.) There is no built-in default login.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=choose-a-strong-password

# Photos (hotels, itineraries) are stored in the database. Upper limit for ALL photos together, in MB (default 350).
# Atlas' free tier holds 512 MB in total, so leave room for the data itself. Uploads are refused with a clear message when full.
# MEDIA_QUOTA_MB=350
